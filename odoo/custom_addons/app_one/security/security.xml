<!-- 
    Security configuration for Real Estate module:
    - Defines a module category 'Real Estate'
    - Creates two user groups: Property Manager and Property User
    - Implements a record rule restricting property record access
    - Ensures users can only view/modify their own created records
    - Limits access to members of the Property User group
-->
<odoo>
    <record id="property_category" model="ir.module.category">
        <field name="name">Real Estate</field>
    </record>

    <record id="property_manager_group" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="category_id" ref="app_one.property_category"/>
    </record>

    <record id="property_user_group" model="res.groups">
        <field name="name">Property User</field>
        <field name="category_id" ref="app_one.property_category"/>
    </record>

    <record id="property_record_rule_by_user" model="ir.rule">
    <field name="name">Property Record Rule By User</field>
    <field name="model_id" ref="app_one.model_property"/>
    <field name="domain_force">[('create_uid', '=', user.id)]</field> <!-- This will allow only the user who created the record to see the record.-->
    <field name="perm_read" eval="True"  />
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
    <!-- <field name="groups" eval="[(4, ref('app_one.property_user_group'))]"/>   # This will allow the user who is in the Property User group to see the record. -->
    </record>
</odoo>