# Odoo Module - Safe Sharing .gitignore

# ================================
# NEVER COMMIT THESE FILES
# ================================

# Configuration files with credentials
odoo.conf
*.conf
.env
*.env

# Database files and backups
*.sql
*.dump
*.backup
*.db

# Log files
*.log
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# ================================
# INCLUDE ONLY APP_ONE MODULE
# ================================

# Include only our custom module
!app_one/

# But exclude any sensitive files within the module
app_one/config/
app_one/*.conf
app_one/*.env
app_one/credentials/
app_one/secrets/

# ================================
# EXCLUDE EVERYTHING ELSE
# ================================

# Core Odoo framework (don't share)
odoo/
addons/

# Other custom modules (keep private)
custom_addons/product_ai_recommendation/
custom_addons/todolistapp/

# Server and deployment files
docker-compose.yml
Dockerfile
nginx.conf
apache.conf

# Backup and migration files
filestore/
sessions/
